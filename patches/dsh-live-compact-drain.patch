+// DRAIN_OLD 2026-11-23：收尾时如果最近的几轮全是 user/tool 且没地方下刀，
+// 原来的 walkOffTail + expandBack 会返回空段，压缩就卡在同一水位反复
+// “drain stopped”。这里退一步，压更早的对话，保留最后两轮用户消息不碰。
+function oldestDrainSpan(items, lastUser, chunkMin, chunkMax, keepUsers = 2) {
+  if (lastUser < 0) return null;
+  let seen = 0;
+  let keepFrom = -1;
+  for (let index = lastUser; index >= 0; index -= 1) {
+    if (items[index].type !== "user") continue;
+    seen += 1;
+    if (seen > keepUsers) {
+      keepFrom = index;
+      break;
+    }
+  }
+  if (keepFrom < 0) return null;
+  let end = keepFrom - 1;
+  while (end >= 0 && (items[end].type === "user" || items[end].checkpoint)) end -= 1;
+  if (end < 0) return null;
+  let start = end;
+  let tokens = items[end].tokens || 0;
+  while (start > 0) {
+    const prev = start - 1;
+    if (items[prev].checkpoint) break;
+    if (tokens + (items[prev].tokens || 0) > chunkMax) break;
+    start = prev;
+    tokens += items[prev].tokens || 0;
+  }
+  while (start < end && items[start].balancedBefore === false) start += 1;
+  if (start >= end || tokens < chunkMin) return null;
+  if (!balanced(items, start, end)) return null;
   return { start, end, tokens, gain: nonUserGain(items, start, end) };
 }
 
