# 复制成 <name>.env 后填值。值不要带引号。

# 短名，用于目录、systemd 单元名、占位符替换
BOT_NAME=alice

# workspace 与 DSH 数据目录
BOT_ROOT=/data/alice-workspace
DSH_ROOT=/data/alice-dsh

# QQ
SELF_UIN=1234567890
OWNER_UIN=1000000001

# OneBot 端口（同一台机器上不能和现有 bot 冲突）
HTTP_PORT=3020
WS_PORT=8100

# dsh web 端口，以及 WebUI 对外端口
WEB_PORT=3082
PANEL_PORT=39275

# 桥 token（不同 bot 建议不同）
BRIDGE_TOKEN=dsh-local-token
WS_TOKEN=dsh-ws-token

# 上游：复用本机网关时填它的地址；独立网关就留空并单独部署
GATEWAY_URL=http://127.0.0.1:39401

# QQ 客户端安装目录（每个 QQ 进程要独立目录，避免抢锁）。留空则用 /data/$BOT_NAME-qq
QQ_HOME=

# 网盘「本子」目录 file_id。留空则本子同步会跳过
BOT_BOOK_DIR=

# 面板里「另一个 bot」的显示名和 QQ（没有就留空）
ALT_BOT_DISPLAY=二号机
ALT_SELF_UIN=
# 默认操作群
GROUP_UIN=
# 可选：服务名。留空则默认 $BOT_NAME-bot / -panel / -gateway / -upstream / -watchdog / -gptsovits
# 老实例服务名对不上时在这里写实际名字
SVC_BOT=
SVC_PANEL=
SVC_GATEWAY=
SVC_UPSTREAM=
SVC_WATCHDOG=
SVC_GPT=
# 可选：插件补丁脚本和快照目录，留空默认 reapply-patches-$BOT_NAME.sh / /root/$BOT_NAME-patches
PATCH_SCRIPT=
PATCH_DIR=
GATEWAY_PORT=0
INSTALL_GATEWAY=0
# INSTALL_GATEWAY=1 时安装 {{SVC_GATEWAY}} 多模型网关；面板的「模型接口」页靠它，未装时面板显示未接。
